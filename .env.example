# URL e anon key del progetto Supabase (Project Settings > API).
# La anon key è pubblica per definizione: è protetta dalle policy RLS.
# NON inserire MAI la service_role key in questo file né in altre variabili VITE_*.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Nome mostrato nell'interfaccia (opzionale)
VITE_APP_NAME=Walk Around

# Mappa: per impostazione predefinita si usano le mattonelle di OpenStreetMap,
# che non richiedono chiavi. Queste due variabili servono solo se si vuole un
# altro servizio (es. CARTO o Stadia con la propria chiave, o un'istanza
# interna). Cambiando servizio va aggiornata anche l'attribuzione: è una
# condizione della licenza.
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?api_key=LA-TUA-CHIAVE
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors, &copy; CARTO
